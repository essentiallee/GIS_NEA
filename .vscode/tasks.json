{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Open GIS_Final in Figma",
      "type": "process",
      "command": "open",
      "args": [
        "https://www.figma.com/design/PaYGMeDTtFoZWBah2SaZfV/GIS_Final?node-id=0-1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "Rebuild map data (Python)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "processing/pipeline.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Query map data (DuckDB)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "processing/query.py",
        "--sql",
        "${input:duckdbSql}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "duckdbSql",
      "type": "promptString",
      "description": "Read-only SQL query",
      "default": "SELECT * FROM accounting"
    }
  ]
}
